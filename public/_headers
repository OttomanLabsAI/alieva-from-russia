/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Static assets are safe to cache hard - change the filename to bust.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML must stay fresh so a deploy is visible immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Vocab app: dictionary and pinned vendor bundles are immutable (renamed when
# they change); config and manifest short; the service worker never cached.
/vocab/dict.json
  Cache-Control: public, max-age=31536000, immutable
/vocab/vendor/*
  Cache-Control: public, max-age=31536000, immutable
/vocab/icons/*
  Cache-Control: public, max-age=604800
/vocab/
  Cache-Control: public, max-age=300
/vocab/config.js
  Cache-Control: public, max-age=300
/vocab/manifest.json
  Cache-Control: public, max-age=300
/vocab/sw.js
  Cache-Control: no-cache
